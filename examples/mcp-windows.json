{
  "mcpServers": {
    "agent-memory": {
      "command": "C:\\Windows\\System32\\wsl.exe",
      "args": [
        "--distribution", "Ubuntu-26.04",
        "--user", "user",
        "--exec", "/home/user/.local/bin/agent-memory",
        "--database", "/home/user/.local/share/agent-memory/agent-memory.sqlite",
        "mcp", "--project", "agent-memory", "--allow-write", "--write-policy", "confirm"
      ]
    }
  }
}
